{format_version:1, definitions:[
  {type:'item', id:'utility_bucket', name:'utility bucket', mass_g:800, volume_ml:14000,
   description:'An empty plastic bucket with a wire bail. The scuffed rim has seen years of ordinary work.', art:'/art/items/utility_bucket/art.txt', flags:['container','rigid','opaque','combustible'], capabilities:[{type:'container',id:'storage',capacity_volume_ml:12000}]},
  {type:'item', id:'water_jerrycan', name:'water jerrycan', mass_g:1100, volume_ml:23000,
   description:'An empty capped plastic jerrycan, made for carrying water long before anyone called it a supply run.', art:'/art/items/water_jerrycan/art.txt', flags:['container','rigid','opaque','watertight','airtight','resealable','combustible','electrically_insulating'], capabilities:[{type:'container',id:'storage',capacity_volume_ml:20000}]},
  {type:'item', id:'metal_toolbox', name:'metal toolbox', mass_g:2500, volume_ml:13000,
   description:'An empty steel toolbox with a folding handle and worn latches. Its previous owner kept the good tools close.', art:'/art/items/metal_toolbox/art.txt', flags:['container','rigid','opaque','ferromagnetic','electrically_conductive','thermally_conductive'], capabilities:[{type:'container',id:'storage',capacity_volume_ml:10000}]},
  {type:'item', id:'glass_jar', name:'glass jar', mass_g:350, volume_ml:1200,
   description:'An empty glass jar with its screw lid. Someone saved it after the contents were gone.', art:'/art/items/glass_jar/art.txt', flags:['container','rigid','transparent','brittle','watertight','airtight','resealable'], capabilities:[{type:'container',id:'storage',capacity_volume_ml:1000}]},
  {type:'item', id:'sleeping_bag', name:'sleeping bag', mass_g:1500, volume_ml:12000,
   description:'Campfire smoke lingers in the seams of this packed synthetic sleeping bag. The nylon compression straps have been cinched by the same hands for years.', art:'/art/items/sleeping_bag/art.txt', flags:['flexible','collapsible','combustible','opaque','electrically_insulating']},
  {type:'item', id:'wool_blanket', name:'wool blanket', mass_g:1600, volume_ml:8000,
   description:'A heavy wool blanket, folded with its striped edge showing. A careful darn interrupts the pattern where someone refused to let a good thing go.', art:'/art/items/wool_blanket/art.txt', flags:['flexible','combustible','water_absorbent','porous','opaque','electrically_insulating']},
  {type:'item', id:'foam_sleeping_mat', name:'foam sleeping mat', mass_g:450, volume_ml:10000,
   description:'An old open-cell foam camping pad, rolled under two straps. The dents remember a sleeper; a scavenger might instead see padding for the next fragile thing worth saving.', art:'/art/items/foam_sleeping_mat/art.txt', flags:['flexible','collapsible','combustible','elastic','water_absorbent','porous','opaque','electrically_insulating']},
  {type:'item', id:'camping_tent', name:'camping tent', mass_g:3200, volume_ml:18000,
   description:'A compact canvas two-person tent, its poles and stakes bundled in a dusty carry bag. The old campsite tag is still tied to a handle; the stout cloth has years left in it.', art:'/art/items/camping_tent/art.txt', flags:['collapsible','combustible','opaque','water_absorbent','porous']},
  {type:'item', id:'candle', name:'candle', mass_g:120, volume_ml:150,
   description:'An unlit wax candle, its wick still straight. It came from a drawer of things saved for an outage.', art:'/art/items/candle/art.txt', flags:['combustible','opaque','electrically_insulating']},
  {type:'item', id:'matchbox', name:'matchbox', mass_g:30, volume_ml:100,
   description:'A small box of matches with a weathered striker. The label advertises a long-closed roadside diner.', art:'/art/items/matchbox/art.txt', flags:['combustible','opaque','abrasive']},
  {type:'item', id:'compass', name:'compass', mass_g:70, volume_ml:100,
   description:'A pocket compass with a scratched cover and a cord polished smooth by handling. Someone carried it long enough to wear a bright crescent into the case.', art:'/art/items/compass/art.txt', flags:['tool','rigid','transparent']},
  {type:'item', id:'sewing_thread', name:'sewing thread', mass_g:50, volume_ml:100,
   description:'A spool of cotton sewing thread with its loose end tucked neatly under the rim. It waited beside a tin of spare buttons for small household emergencies.', art:'/art/items/sewing_thread/art.txt', flags:['salvage','combustible','flexible','water_absorbent','porous','opaque','electrically_insulating']},
  {type:'item', id:'epoxy_adhesive', name:'epoxy adhesive', mass_g:100, volume_ml:130,
   description:'A two-part epoxy pack, its resin and hardener still separate. A thumbprint in the workshop dust marks where someone checked the instructions before setting it aside.', art:'/art/items/epoxy_adhesive/art.txt', flags:['salvage','toxic_on_ingestion','skin_irritant','opaque']},
  {type:'item', id:'solder_wire', name:'solder wire', mass_g:100, volume_ml:100,
   description:'A small spool of solder wire with the loose end bent back against the reel. Someone kept a tidy bench, even when the repairs began to outnumber the working things.', art:'/art/items/solder_wire/art.txt', flags:['salvage','flexible','opaque','electrically_conductive','thermally_conductive']},
  {type:'item', id:'rolled_oats', name:'rolled oats', mass_g:550, volume_ml:1800,
   description:'A full cardboard canister of rolled oats. The paper label still shows a breakfast table set for a family.', art:'/art/items/rolled_oats/art.txt', flags:['food','combustible','opaque']},
  {type:'item', id:'canned_tuna', name:'canned tuna', mass_g:185, volume_ml:220,
   description:'A sealed can of tuna with a faded blue label. It belonged to the quiet reserve at the back of a cupboard, behind the things people actually planned to eat that week.', art:'/art/items/canned_tuna/art.txt', flags:['food','container','rigid','opaque','watertight','airtight','ferromagnetic','electrically_conductive','thermally_conductive']},
  {type:'item', id:'trail_mix', name:'trail mix', mass_g:220, volume_ml:400,
   description:'A sealed packet of nuts and dried fruit, once sold beside maps and camping fuel. The pictured trail ends at a sunlit overlook, with no suggestion of a return journey.', art:'/art/items/trail_mix/art.txt', flags:['food','flexible','opaque','watertight','airtight']},
  {type:'item', id:'toilet_paper', name:'toilet paper', mass_g:120, volume_ml:1400,
   description:'A roll of toilet paper. Civilization collapsed, but the shortage remains a remarkably durable institution.', art:'/art/items/toilet_paper/art.txt', flags:['combustible','water_absorbent','porous']},
  {type:'item', id:'toothpaste', name:'toothpaste', mass_g:150, volume_ml:180,
   description:'A full capped tube of toothpaste with a dried fleck of mint paste on its shoulder. For a moment it brings back the sink, the mirror, and an ordinary morning with somewhere to be.', art:'/art/items/toothpaste/art.txt', flags:['flexible','opaque']},
  {type:'item', id:'toy_robot', name:'toy robot', mass_g:600, volume_ml:1400,
   description:'A small electronic robot with paint worn off the toes and a patient molded smile. Behind that familiar face are a motor, a control board, and the little lights that once brought it to life.', art:'/art/items/toy_robot/art.txt', flags:['electronics','rigid','opaque','combustible']},
]}
