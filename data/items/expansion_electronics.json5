{format_version:1, definitions:[
  {type:'item',id:'resistor',name:'resistor',mass_g:1,volume_ml:2,description:'A banded resistor from a parts drawer, small enough to disappear into the dust at its bottom.',art:'/art/items/resistor/art.txt',flags:['salvage','electronics','electrically_conductive','opaque','rigid']},
  {type:'item',id:'capacitor',name:'capacitor',mass_g:5,volume_ml:8,description:'An electrolytic capacitor with a faded stripe marking its polarity. Someone kept spares for a repair that never happened.',art:'/art/items/capacitor/art.txt',flags:['salvage','electronics','electrically_conductive','opaque','rigid']},
  {type:'item',id:'light_emitting_diode',name:'light-emitting diode',mass_g:1,volume_ml:2,description:'A clear red indicator LED with two bare leads, still caught in a strip of parts tape. There was a time when this much red meant only that a machine was waiting.',art:'/art/items/light_emitting_diode/art.txt',flags:['salvage','electronics','electrically_conductive','combustible','transparent','rigid']},
  {type:'item',id:'toggle_switch',name:'toggle switch',mass_g:20,volume_ml:30,description:'A panel toggle switch with its mounting hardware still attached. Its worn lever has known many hands.',art:'/art/items/toggle_switch/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','combustible','rigid','opaque']},
  {type:'item',id:'power_relay',name:'power relay',mass_g:35,volume_ml:45,description:'A boxed electrical relay with bare contact pins underneath. A maintenance date in pencil records the last time someone expected the control cabinet to need them.',art:'/art/items/power_relay/art.txt',flags:['salvage','electronics','electrically_conductive','ferromagnetic','combustible','opaque','rigid']},
  {type:'item',id:'cartridge_fuse',name:'cartridge fuse',mass_g:5,volume_ml:8,description:'A glass cartridge fuse with metal caps and a fine wire inside. It came from a drawer of replacements, each little compartment labeled in a careful hand.',art:'/art/items/cartridge_fuse/art.txt',flags:['salvage','electrically_conductive','transparent','brittle','rigid']},
  {type:'item',id:'electrical_connector',name:'electrical connector',mass_g:15,volume_ml:25,description:'A multi-pin connector with exposed brass contacts and an intact latch. The matching half stayed with a machine somebody else carried away.',art:'/art/items/electrical_connector/art.txt',flags:['salvage','electrically_conductive','combustible','opaque','rigid']},
  {type:'item',id:'insulated_power_cable',name:'insulated power cable',mass_g:350,volume_ml:500,description:'A short complete power cable with molded plugs and exposed contacts. Its insulation bears the scuffs of years behind a desk.',art:'/art/items/insulated_power_cable/art.txt',flags:['salvage','electrically_conductive','combustible','flexible','opaque']},
  {type:'item',id:'transformer',name:'transformer',mass_g:600,volume_ml:500,description:'A compact iron-core transformer, heavy for its size, with bare solder lugs. The winding is worth carrying home for its copper.',art:'/art/items/transformer/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','rigid','opaque']},
  {type:'item',id:'induction_coil',name:'induction coil',mass_g:250,volume_ml:300,description:'A substantial copper winding from bench equipment, its lacquer darkened with age and its terminal ends scraped bare. Someone tied it neatly before setting it among the spare parts.',art:'/art/items/induction_coil/art.txt',flags:['salvage','electrically_conductive','rigid','opaque']},
  {type:'item',id:'heating_element',name:'heating element',mass_g:250,volume_ml:450,description:'A framed resistance element with exposed wire and old ceramic supports. Toast crumbs cling in the corners, remnants of mornings when a warm kitchen was ordinary.',art:'/art/items/heating_element/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','rigid','opaque']},
  {type:'item',id:'processor_chip',name:'processor chip',mass_g:20,volume_ml:20,description:'A processor in its black molded package, the bare pins still straight. A penciled inventory number connects it to a machine long since dismantled.',art:'/art/items/processor_chip/art.txt',flags:['salvage','electronics','electrically_conductive','combustible','rigid','opaque']},
  {type:'item',id:'memory_module',name:'memory module',mass_g:30,volume_ml:45,description:'A memory module from a desktop computer. Dust remains along the edge that faced the fan, while the gold contacts bear the narrow marks of their old socket.',art:'/art/items/memory_module/art.txt',flags:['salvage','electronics','electrically_conductive','combustible','rigid','opaque']},
  {type:'item',id:'solid_state_drive',name:'solid-state drive',mass_g:80,volume_ml:120,description:'A solid-state drive in a slim aluminum case. A handwritten family name on the label makes it harder to drop among the anonymous scrap.',art:'/art/items/solid_state_drive/art.txt',flags:['salvage','electronics','electrically_conductive','thermally_conductive','rigid','opaque']},
  {type:'item',id:'computer_power_supply',name:'computer power supply',mass_g:1500,volume_ml:2500,description:'A heavy steel-cased computer power supply from an old industrial desktop, built around an iron-core transformer. A service label covers an earlier service label; this machine was kept going for years.',art:'/art/items/computer_power_supply/art.txt',flags:['salvage','electronics','electrically_conductive','thermally_conductive','rigid','opaque','ferromagnetic']},
  {type:'item',id:'cooling_fan',name:'cooling fan',mass_g:120,volume_ml:350,description:'A plastic-framed computer fan with a dusty hub. A clean circle on the rear label shows where a repair-shop sticker used to sit; the little motor is still inside.',art:'/art/items/cooling_fan/art.txt',flags:['salvage','electronics','ferromagnetic','combustible','rigid','opaque']},
  {type:'item',id:'display_module',name:'display module',mass_g:150,volume_ml:250,description:'A small unpowered display on a circuit board, its contact row still intact. A pale rectangle marks where an operator taped a reminder along the bezel.',art:'/art/items/display_module/art.txt',flags:['salvage','electronics','electrically_conductive','combustible','rigid','opaque']},
  {type:'item',id:'distance_sensor',name:'distance sensor',mass_g:30,volume_ml:60,description:'A ranging board with paired ultrasonic transducers and bare contacts. A school lab inventory sticker survives on the back, from a time when an empty corridor was only a place to measure.',art:'/art/items/distance_sensor/art.txt',flags:['salvage','electronics','electrically_conductive','combustible','rigid','opaque']},
  {type:'item',id:'toaster',name:'toaster',mass_g:1600,volume_ml:5500,description:'A two-slot toaster with crumbs inside. Its warranty did not anticipate the end of breakfast.',art:'/art/items/toaster/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','rigid','opaque','ferromagnetic']},
  {type:'item',id:'desk_radio',name:'desk radio',mass_g:900,volume_ml:2500,description:'A small plastic-cased desk radio, its tuning scale worn smooth by a familiar hand and its metal antenna still attached. The case still holds a trove of components.',art:'/art/items/desk_radio/art.txt',flags:['salvage','electronics','electrically_conductive','combustible','rigid','opaque']},
]}
