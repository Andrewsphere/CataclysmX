{format_version: 1, definitions: [
  // Shared descriptive vocabulary. No flag grants behavior, a tool tier, or a state.
  // Flag IDs occupy their own namespace, separate from ordinary definition IDs.
  {type:'flag', id:'salvage', name:'salvage', description:'Material or a component kept primarily as feedstock for making or repairing other objects.', domains:['item','object'], kind:'category'},
  {type:'flag', id:'tool', name:'tool', description:'Equipment designed primarily to perform a practical task other than combat; specific capabilities require separate definitions.', domains:['item','object'], kind:'category'},
  {type:'flag', id:'melee_weapon', name:'melee weapon', description:'An implement designed or deliberately adapted for hand-held close combat, rather than merely usable as an improvised weapon.', domains:['item'], kind:'category'},
  {type:'flag', id:'firearm', name:'firearm', description:'A weapon designed to propel a projectile by the pressure of burning propellant; does not imply a working firing action.', domains:['item','object'], kind:'category'},
  {type:'flag', id:'ammunition', name:'ammunition', description:'A represented unit of projectile, propellant, or assembled rounds intended to be expended by a ranged weapon.', domains:['item'], kind:'category'},
  {type:'flag', id:'armor', name:'armor', description:'Equipment designed primarily to protect its wearer against physical attack; does not assign protection values.', domains:['item'], kind:'category'},
  {type:'flag', id:'clothing', name:'clothing', description:'A garment designed to be worn on the body, whether or not it also serves as armor.', domains:['item'], kind:'category'},
  {type:'flag', id:'container', name:'container', description:'An article designed to hold other objects or substances within a defined interior; capacity and storage behavior are separate.', domains:['item','object'], kind:'category'},
  {type:'flag', id:'food', name:'food', description:'A substance or packaged portion intended to supply nourishment when eaten or drunk; not a guarantee of current safety.', domains:['item'], kind:'category'},
  {type:'flag', id:'medicine', name:'medicine', description:'A preparation or consumable medical supply intended for treatment or prevention of injury or illness; no treatment effect is implied.', domains:['item'], kind:'category'},
  {type:'flag', id:'electronics', name:'electronics', description:'Equipment or an assembly whose intended function depends on electronic components, rather than merely conducting electricity.', domains:['item','object'], kind:'category'},
  {type:'flag', id:'book', name:'book', description:'A bound collection of pages intended to convey written or illustrated information.', domains:['item'], kind:'category'},
  {type:'flag', id:'electrically_conductive', name:'electrically conductive', description:'An exposed substantial part conducts electrical current under ordinary dry contact; insulated internal wiring alone does not qualify.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'ferromagnetic', name:'ferromagnetic', description:'A substantial constituent is strongly attracted by an ordinary magnet, as iron and common plain steels are; does not mean permanently magnetized.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'combustible', name:'combustible', description:'A substantial constituent can sustain combustion in air after sufficient ignition heating; does not specify ignition temperature or burn rate.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'water_absorbent', name:'water absorbent', description:'An exposed substantial constituent takes liquid water into its bulk or fiber structure, rather than merely becoming wet on the surface.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'water_soluble', name:'water soluble', description:'The principal represented substance dissolves appreciably in room-temperature water; dispersion, swelling, and rusting do not qualify.', domains:['item','terrain','object'], kind:'property'},
  {type:'flag', id:'brittle', name:'brittle', description:'The principal load-bearing material tends to crack or shatter under overload with little permanent bending first.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'flexible', name:'flexible', description:'The main body can be bent substantially in ordinary handling without fracture; a small flexible attachment alone does not qualify.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'sharp_edge', name:'sharp edge', description:'The authored intact form has an exposed edge shaped to concentrate force for cutting; hypothetical broken edges do not qualify.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'pointed', name:'pointed', description:'The authored intact form has an exposed narrow tip capable of concentrating contact force; does not assign piercing damage.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'collapsible', name:'collapsible', description:'Designed to fold, telescope, or dismantle reversibly into a smaller packed form; ordinary bending or crumpling alone does not qualify.', domains:['item','object'], kind:'property'},
  {type:'flag', id:'watertight', name:'watertight', description:'The intact enclosing body and any supplied closure are designed to prevent liquid-water passage in ordinary use; does not mean currently closed or submersible.', domains:['item','terrain','object'], kind:'property'},
  {type:'flag', id:'airtight', name:'airtight', description:'The intact enclosing body and supplied seals are designed to prevent ordinary gas exchange when properly closed; does not encode current closure state or pressure rating.', domains:['item','terrain','object'], kind:'property'},
  {type:'flag', id:'resealable', name:'resealable', description:'Includes a closure designed to be opened and closed repeatedly while restoring its intended seal; a missing or hypothetical stopper does not qualify.', domains:['item','object'], kind:'property'},
  {type:'flag', id:'toxic_on_ingestion', name:'toxic on ingestion', description:'The represented substance is poisonous when swallowed in quantities plausible for accidental ingestion, beyond ordinary choking or sharp-fragment hazards.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'skin_irritant', name:'skin irritant', description:'Ordinary direct contact with the represented substance can cause chemical skin irritation; abrasion, heat, and puncture alone do not qualify.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'corrosive', name:'corrosive', description:'The represented substance chemically attacks ordinary contacted tissue or construction materials under normal handling conditions; rust on an object does not qualify.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'transparent', name:'transparent', description:'A substantial surface transmits visible light clearly enough to distinguish objects through it; does not imply an unobstructed whole-object sight line.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'opaque', name:'opaque', description:'The main body does not transmit visible light through its material at the represented thickness; gaps and openings are not material transparency.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'rigid', name:'rigid', description:'The main structural body retains its shape under ordinary handling rather than folding or bending readily; small flexible attachments are allowed.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'porous', name:'porous', description:'Exposed material has connected pores or interstices into which liquids or fine contaminants can enter; a hollow interior alone does not qualify.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'abrasive', name:'abrasive', description:'An exposed working surface is sufficiently hard and rough to wear away softer material by deliberate rubbing; incidental texture alone does not qualify.', domains:['item','terrain','object'], kind:'property'},
  {type:'flag', id:'elastic', name:'elastic', description:'The main body can stretch or compress appreciably in ordinary use and substantially return to its original form when released.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'thermally_conductive', name:'thermally conductive', description:'An exposed substantial continuous part readily carries heat along itself, as a metal utensil does; does not specify heat resistance.', domains:['item','monster','terrain','object'], kind:'property'},
  {type:'flag', id:'electrically_insulating', name:'electrically insulating', description:'The principal exposed body resists electrical current in ordinary dry handling and has no exposed conductive working part; not a certified safety rating.', domains:['item','monster','terrain','object'], kind:'property'},
]}
