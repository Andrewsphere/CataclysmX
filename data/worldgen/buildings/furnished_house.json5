{format_version:1, definitions:[{
  type:'building_pattern', id:'furnished_house', weight:1000, use:'residential',
  // Kitchen/dining west, sitting/sleeping east, enclosed WC northeast.
  rows:[
    '###w####u###',
    '#KPS..#.#Bt#',
    '#q.cTE#.#v.#',
    '#s....+.#+##',
    '#..l..#..l.#',
    '#k....#a.ob#',
    '#..>..#..rL#',
    '###+########',
  ],
  palette:{'#':'wall', '.':'floor', '+':'closed_door', '>':'stairs', w:'window',u:'window_curtained',
    E:{terrain:'floor',loot:[
      {pool:'power_starter_wire',destination:'ground'},{pool:'power_starter_meter',destination:'ground'},
      {pool:'power_starter_generator',destination:'ground'},{pool:'power_starter_fuel',destination:'ground'},
      {pool:'power_starter_battery',destination:'ground'},{pool:'power_starter_iron',destination:'ground'},
      {pool:'power_starter_solder',destination:'ground'},{pool:'power_starter_copper',destination:'ground'}]},
    M:{terrain:'floor',object:'grid_scrap_press'},
    s:{terrain:'floor',object:'kitchen_stove',facing:'east'},
    q:{terrain:'floor',loot:[{pool:'loot_kitchen_appliance_ground',chance:2000,destination:'ground'}]},
    v:{terrain:'floor',loot:[{pool:'loot_cleaning_bulk_ground',chance:2000,destination:'ground'}]},
    o:{terrain:'floor',loot:[{pool:'loot_outerwear_ground',chance:1500,destination:'ground'}]},
    r:{terrain:'floor',loot:[{pool:'loot_camping_bulk_ground',chance:1500,destination:'ground'}]},
    F:{terrain:'floor',loot:[{pool:'loot_workshop_bulk_ground',chance:4000,destination:'ground'}]},
    t:{terrain:'floor',object:'house_toilet',facing:'west'},
    a:{terrain:'floor',object:'house_sofa',facing:'east'},
    K:{terrain:'floor',object:'kitchen_cabinet',facing:'south',loot:[{pool:'house_kitchen',destination:'furniture'}]},
    P:{terrain:'floor',object:'kitchen_cabinet',facing:'south',loot:[{pool:'house_pantry',destination:'furniture'},{pool:'house_household_supplies',rolls:2,destination:'furniture'}]},
    S:{terrain:'floor',object:'kitchen_sink',facing:'south'},
    c:{terrain:'floor',object:'house_chair',facing:'east'},
    T:{terrain:'floor',object:'house_table'},
    k:{terrain:'floor',object:'kitchen_cabinet',facing:'east'},
    B:{terrain:'floor',object:'bathroom_cabinet',facing:'south',loot:[{pool:'house_bathroom',destination:'furniture'}]},
    b:{terrain:'floor',object:'house_bed',facing:'west'},
    L:{terrain:'floor',object:'bedroom_cabinet',facing:'west',loot:[{pool:'house_linen',destination:'furniture'}]},
    l:{terrain:'floor',object:'cellar_lamp'},
    C:{terrain:'floor',object:'cellar_chest',facing:'south',loot:[{pool:'house_storage',rolls:2,destination:'furniture'}]},
    p:{terrain:'floor',object:'kitchen_cabinet',facing:'west',loot:[{pool:'loot_dry_staples',rolls:2,destination:'furniture'}]},
    d:{terrain:'floor',object:'bedroom_cabinet',facing:'east',loot:[{pool:'loot_computer_parts',chance:4500,destination:'furniture'}]},
    H:{terrain:'floor',object:'bathroom_cabinet',loot:[{pool:'house_household_supplies',rolls:2,destination:'furniture'}]},
    W:{terrain:'floor',object:'workshop_bench',facing:'south',loot:[{pool:'house_hammer',destination:'furniture'},{pool:'house_workshop',rolls:3,destination:'furniture'}]},
    h:{terrain:'floor',object:'cellar_chest',facing:'east',loot:[{pool:'house_household_supplies',destination:'furniture'},{pool:'loot_electrical_parts',chance:5000,destination:'furniture'}]},
    D:{terrain:'floor',object:'bedroom_cabinet'},
    Z:{terrain:'floor',monsters:[{group:'cellar_zombies',chance:3000}]},
  },
  entrance:{x:3,z:7},
  basements:[
    // Rear pantry/storage room; cupboards beside the stair landing.
    {id:'storage_cellar',weight:1,rows:[
      '############','#C........p#','#........M.#','#..........#',
      '####+#######','#d..l......#','#..>......H#','############',
    ]},
    // Bench/tool room and household/bulk-storage landing.
    {id:'workshop_cellar',weight:1,rows:[
      '############','#WF....C..Z#','#........M.#','#..........#',
      '####+#######','#h..l......#','#..>......D#','############',
    ]},
  ],
}]}
