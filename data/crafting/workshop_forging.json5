{format_version:1, definitions:[
  // Whole stock units; work is base work, not elapsed wall-clock time.
  // 24,200 g -> 24,000 g. Mounting needs no pre-existing station.
  {type:'recipe',id:'assemble_crude_anvil',name:'Mount a crude anvil',
   inputs:[{item:'solid_steel_block',count:1},{item:'timber_plank',count:2},{item:'nuts_and_bolts',count:1},
           {item:'hacksaw',count:1,retained:true}],
   tool_traits:[{id:'hammering',tier:1},{id:'metal_drilling',tier:1},{id:'wrenching',tier:1}],
   result:{item:'crude_anvil_kit',count:1},work:2400,
   skills:[{skill:'fabrication',level:1}],knowledge:{known_by_default:true}},
  // 27,880 g -> 27,000 g. Cold assembly; no fuel or forge prerequisite.
  {type:'recipe',id:'assemble_charcoal_forge',name:'Assemble a charcoal forge',
   inputs:[{item:'refractory_brick',count:8},{item:'steel_sheet',count:2},{item:'steel_pipe',count:1},
           {item:'timber_plank',count:1},{item:'leather_patch',count:4},{item:'nuts_and_bolts',count:1},
           {item:'metal_file',count:1,retained:true},{item:'retractable_utility_knife',count:1,retained:true}],
   tool_traits:[{id:'hammering',tier:1},{id:'metal_saw',tier:1},{id:'metal_drilling',tier:1},{id:'wrenching',tier:1}],
   result:{item:'charcoal_forge_kit',count:1},work:5000,
   skills:[{skill:'fabrication',level:2}],knowledge:{known_by_default:true}},
  // 1,800 g -> 1,500 g. Ordinary pliers hold stock for the first tongs.
  {type:'recipe',id:'forge_tongs',name:'Forge a pair of tongs',
   inputs:[{item:'steel_rod',count:2},{item:'nuts_and_bolts',count:1},
           {item:'hacksaw',count:1,retained:true},{item:'metal_file',count:1,retained:true},
           {item:'hand_drill',count:1,retained:true},{item:'adjustable_wrench',count:1,retained:true}],
   tool_traits:[{id:'hammering',tier:1},{id:'anvil',tier:1},{id:'forge_heat',tier:1},{id:'metal_holding',tier:1}],
   heat_per_work:10000,result:{item:'forging_tongs',count:1},work:3200,
   skills:[{skill:'fabrication',level:2}],knowledge:{known_by_default:true}},
  // 1,800 g -> five 300 g blanks; scale and saw kerf are not products.
  {type:'recipe',id:'cut_tool_steel_blanks',name:'Prepare tool-steel blanks',
   inputs:[{item:'spring_steel_bar',count:1}],
   tool_traits:[{id:'forge_heat',tier:1},{id:'metal_holding',tier:2},{id:'metal_saw',tier:1}],
   heat_per_work:10000,result:{item:'tool_steel_blank',count:5},work:1800,
   skills:[{skill:'fabrication',level:2}],knowledge:{known_by_default:true}},
  // 6,800 g -> 6,000 g. A found chisel permits F2 joinery before F3 manufacture.
  {type:'recipe',id:'make_wooden_workshop_crate',name:'Build a wooden workshop crate',
   inputs:[{item:'timber_plank',count:3},{item:'wooden_dowel',count:2},{item:'wood_screws',count:1},
           {item:'hacksaw',count:1,retained:true},{item:'wood_chisel',count:1,retained:true}],
   tool_traits:[{id:'hammering',tier:1},{id:'screwdriving',tier:1}],
   result:{item:'wooden_workshop_crate',count:1},work:2400,
   skills:[{skill:'fabrication',level:2}],knowledge:{known_by_default:true}},
  // Existing 1,200 g product needs two 800 g rods, not one.
  {type:'recipe',id:'forge_pry_bar',name:'Forge a pry bar',
   inputs:[{item:'steel_rod',count:2},{item:'hacksaw',count:1,retained:true},{item:'metal_file',count:1,retained:true}],
   tool_traits:[{id:'hammering',tier:1},{id:'anvil',tier:1},{id:'forge_heat',tier:1},{id:'metal_holding',tier:2}],
   heat_per_work:10000,result:{item:'pry_bar',count:1},work:3000,
   skills:[{skill:'fabrication',level:2}],knowledge:{known_by_default:true}},
  // Four blanks give a substantial head; 1,400 g -> 1,300 g including handle.
  {type:'recipe',id:'forge_smithing_hammer',name:'Forge a smithing hammer',
   inputs:[{item:'tool_steel_blank',count:4},{item:'wood_scrap',count:1},
           {item:'hacksaw',count:1,retained:true},{item:'metal_file',count:1,retained:true},
           {item:'hand_drill',count:1,retained:true},{item:'retractable_utility_knife',count:1,retained:true}],
   tool_traits:[{id:'hammering',tier:1},{id:'anvil',tier:1},{id:'forge_heat',tier:1},{id:'metal_holding',tier:2}],
   heat_per_work:10000,result:{item:'smithing_hammer',count:1},work:4800,
   skills:[{skill:'fabrication',level:3}],knowledge:{known_by_default:true}},
  // 25,600 g -> 25,000 g. W3B's welded producer shares the conservative recycler below.
  {type:'recipe',id:'assemble_fabricated_anvil',name:'Fit a fabricated anvil',
   inputs:[{item:'solid_steel_block',count:1},{item:'tool_steel_blank',count:4},
           {item:'timber_plank',count:2},{item:'nuts_and_bolts',count:2},
           {item:'hacksaw',count:1,retained:true},{item:'metal_file',count:1,retained:true},
           {item:'hand_drill',count:1,retained:true},{item:'adjustable_wrench',count:1,retained:true}],
   tool_traits:[{id:'hammering',tier:2},{id:'anvil',tier:1},{id:'forge_heat',tier:1},{id:'metal_holding',tier:2}],
   heat_per_work:10000,result:{item:'fabricated_anvil_kit',count:1},work:6000,
   skills:[{skill:'fabrication',level:3}],knowledge:{known_by_default:true}},
  // 500 g -> existing 220 g chisel. Preserve its existing 100 g scrap recycler.
  {type:'recipe',id:'forge_wood_chisel',name:'Forge a wood chisel',
   inputs:[{item:'tool_steel_blank',count:1},{item:'wood_scrap',count:1},
           {item:'hacksaw',count:1,retained:true},{item:'metal_file',count:1,retained:true},
           {item:'hand_drill',count:1,retained:true},{item:'retractable_utility_knife',count:1,retained:true}],
   tool_traits:[{id:'hammering',tier:2},{id:'anvil',tier:1},{id:'forge_heat',tier:1},{id:'metal_holding',tier:2}],
   heat_per_work:10000,result:{item:'wood_chisel',count:1},work:3000,
   skills:[{skill:'fabrication',level:3}],knowledge:{known_by_default:true}},

  // Explicit destructive salvage never reconstructs suitable steel from mixed scrap.
  // Brick remains usable as-is, and charcoal has no recycler; fuel is never returned.
  {type:'recycling_recipe',id:'cut_solid_steel_block',name:'Cut a steel block into scrap',
   target:'solid_steel_block',tool_traits:[{id:'metal_saw',tier:1}],
   returns:[{item:'steel_scrap',count:150}],work:6000,training:[{skill:'fabrication',level:0}]},
  {type:'recycling_recipe',id:'dismantle_crude_anvil',name:'Dismantle a crude anvil',
   target:'crude_anvil_kit',tool_traits:[{id:'wrenching',tier:1}],
   returns:[{item:'solid_steel_block',count:1},{item:'wood_scrap',count:10},{item:'steel_scrap',count:1}],
   work:800,training:[{skill:'fabrication',level:0}]},
  {type:'recycling_recipe',id:'dismantle_charcoal_forge',name:'Dismantle a cold forge',
   target:'charcoal_forge_kit',tool_traits:[{id:'wrenching',tier:1}],
   returns:[{item:'refractory_brick',count:6},{item:'steel_scrap',count:30},{item:'wood_scrap',count:5}],
   work:1600,training:[{skill:'fabrication',level:0}]},
  {type:'recycling_recipe',id:'salvage_forging_tongs',name:'Cut up forging tongs',
   target:'forging_tongs',tool_traits:[{id:'metal_saw',tier:1}],
   returns:[{item:'steel_scrap',count:12}],work:500,training:[{skill:'fabrication',level:0}]},
  {type:'recycling_recipe',id:'salvage_smithing_hammer',name:'Strip a smithing hammer',
   target:'smithing_hammer',inputs:[{item:'claw_hammer',count:1,retained:true}],
   returns:[{item:'steel_scrap',count:10}],work:400,training:[{skill:'fabrication',level:0}]},
  {type:'recycling_recipe',id:'dismantle_fabricated_anvil',name:'Dismantle a fabricated anvil',
   target:'fabricated_anvil_kit',inputs:[{item:'metal_file',count:1,retained:true}],
   tool_traits:[{id:'wrenching',tier:1},{id:'metal_saw',tier:1}],
   returns:[{item:'solid_steel_block',count:1},{item:'steel_scrap',count:8},{item:'wood_scrap',count:10}],
   work:1800,training:[{skill:'fabrication',level:0}]},
  {type:'recycling_recipe',id:'cut_spring_steel_bar',name:'Cut a spring-steel bar into scrap',
   target:'spring_steel_bar',tool_traits:[{id:'metal_saw',tier:1}],
   returns:[{item:'steel_scrap',count:12}],work:600,training:[{skill:'fabrication',level:0}]},
  {type:'recycling_recipe',id:'scrap_tool_steel_blank',name:'Cut a tool-steel blank into scrap',
   target:'tool_steel_blank',tool_traits:[{id:'metal_saw',tier:1}],
   returns:[{item:'steel_scrap',count:2}],work:200,training:[{skill:'fabrication',level:0}]},
  {type:'recycling_recipe',id:'dismantle_wooden_workshop_crate',name:'Dismantle a wooden crate',
   target:'wooden_workshop_crate',tool_traits:[{id:'screwdriving',tier:1}],
   returns:[{item:'wood_scrap',count:20}],work:600,training:[{skill:'fabrication',level:0}]},
  {type:'recycling_recipe',id:'salvage_pry_bar',name:'Cut up a pry bar',
   target:'pry_bar',tool_traits:[{id:'metal_saw',tier:1}],
   returns:[{item:'steel_scrap',count:10}],work:500,training:[{skill:'fabrication',level:0}]},
]}
