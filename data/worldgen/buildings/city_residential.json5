  {
    type:'building_pattern', id:'modular_cottage_row_single_storey',
    family:'modular_cottage_row', family_weight:1100, weight:2,
    use:'residential', era:'newer', min_settlement_size:'small', occupied_floors:1,
    // Three independent homes, each with a front door and a rear service-strip exit.
    rows:[
      ':::::::::::::::::::::::::::::::',
      'ggg:::ggggggg:::ggggggg:::ggggg',
      '###G#########G#########G#######',
      '#b..Iqh.d.Ib..Iqh.d.Ib..Iqh.d.#',
