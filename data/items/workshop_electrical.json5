{format_version:1, definitions:[
  // One pair. No recycler: the intact lenses are more useful than broken plastic.
  {type:'item',id:'sunglasses',name:'sunglasses',mass_g:40,volume_ml:150,
   description:'A pair of dark glasses with one temple polished by a familiar hand. They belonged to days planned around the weather.',
   flags:['clothing','rigid','transparent','combustible'],
   art:'/art/items/sunglasses/art.txt'},
  // Salvage only the frame stock, not three usable pairs of lenses.
  {type:'item',id:'improvised_welding_goggles',name:'improvised welding goggles',mass_g:180,volume_ml:500,
   description:'Layers of scavenged dark lenses sit in a taped homemade frame. Every overlap records the patience of someone determined to get a workshop running again.',
   flags:['tool','clothing','rigid','opaque','combustible'],
   tool_traits:[{id:'welding_protection',tier:1}],
   art:'/art/items/improvised_welding_goggles/art.txt'},
  // No recycler: prepared optical material is not manufactured from generic scrap.
  {type:'item',id:'welding_filter',name:'welding filter insert',mass_g:100,volume_ml:80,
   description:'A dark rectangular filter, still tucked into its folded inspection sleeve. The little approval stamp is a surviving fragment of somebody taking care.',
   flags:['salvage','rigid','brittle','transparent'],
   art:'/art/items/welding_filter/art.txt'},
  {type:'item',id:'welding_mask',name:'welding mask',mass_g:650,volume_ml:3500,
   description:'A proper dark filter looks out from a broad protective shell. Sweat has worn the headband smooth in the place where a forehead always rested.',
   flags:['tool','clothing','rigid','opaque','combustible'],
   tool_traits:[{id:'welding_protection',tier:2}],
   art:'/art/items/welding_mask/art.txt'},
  {type:'item',id:'salvaged_welder_power_module',name:'salvaged welder power module',mass_g:8000,volume_ml:5000,
   description:'A working high-current power stage with its heavy output connections still attached. Someone labeled the disconnected control wires before lifting it out; that care is worth more than the copper.',
   flags:['salvage','electronics','rigid','opaque','ferromagnetic','electrically_conductive'],
   art:'/art/items/salvaged_welder_power_module/art.txt'},
  {type:'item',id:'electrical_lead_set',name:'electrical lead set',mass_g:400,volume_ml:600,
   description:'Recovered insulated cable ends in carefully fitted connectors. The matching marks on each end turn a drawerful of loose parts into something worth trusting.',
   flags:['salvage','flexible','opaque','combustible','electrically_conductive'],
   art:'/art/items/electrical_lead_set/art.txt'},
  {type:'item',id:'makeshift_arc_welder',name:'makeshift arc welder',mass_g:10000,volume_ml:11000,
   description:'A recovered power stage humbles its new sheet-metal case, with cables bundled clear of the salvaged fan. Fresh file marks stand out among the older workshop scars.',
   flags:['tool','electronics','rigid','opaque','ferromagnetic','electrically_conductive'],
   tool_traits:[{id:'welding',tier:1}],crafting_power:{store:'grid',energy_per_work:30000},
   art:'/art/items/makeshift_arc_welder/art.txt'},
  {type:'item',id:'arc_welder',name:'regulated arc welder',mass_g:12000,volume_ml:14000,
   description:'A compact regulated welder with its holder and ground lead coiled beside the case. The current dial still has a grease-pencil mark where its last owner liked to leave it.',
   flags:['tool','electronics','rigid','opaque','ferromagnetic','electrically_conductive'],
   tool_traits:[{id:'welding',tier:2}],crafting_power:{store:'grid',energy_per_work:20000},
   art:'/art/items/arc_welder/art.txt'},
  // No recycler. Consumed electrodes never return from completed welded products.
  {type:'item',id:'welding_electrode_packet',name:'welding electrode packet',mass_g:1000,volume_ml:700,
   description:'A dry sleeve of compatible coated welding rods, folded tight against the damp. Enough patient joints remain inside to make another corner of the shelter permanent.',
   flags:['salvage','rigid','opaque','ferromagnetic'],recovery_allowed:false,
   art:'/art/items/welding_electrode_packet/art.txt'},
  {type:'item',id:'welded_workshop_rack_kit',name:'welded workshop rack kit',mass_g:21000,volume_ml:36000,
   description:'Welded shelf frames nest together under a bundle of bolts. There is something heartening about making a place for supplies before the next trip brings them home.',
   flags:['tool','container','collapsible','rigid','opaque','ferromagnetic','electrically_conductive'],
   placed_object:'welded_workshop_rack',art:'/art/items/welded_workshop_rack_kit/art.txt'},
  {type:'item',id:'workshop_battery_pack',name:'workshop battery pack',mass_g:750,volume_ml:1000,
   description:'Four recovered rechargeable cells share a fitted case and a pair of labeled terminals. It is a small reserve, kept for the moment the light or the tools must not stop.',
   flags:['electronics','rigid','opaque','combustible','electrically_conductive'],
   placed_object:'grid_battery_station',
   capabilities:[{type:'energy_store',id:'power',capacity_energy:4000,initial_energy:0,rechargeable:true}],
   art:'/art/items/workshop_battery_pack/art.txt'},
]}
