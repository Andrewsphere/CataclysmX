{format_version:1, definitions:[
  {type:'item',id:'steel_pipe',name:'steel pipe',mass_g:1200,volume_ml:1400,description:'A short steel pipe from a stack that once waited for a plumber. Even a small section is worth carrying back to a saw.',art:'/art/items/steel_pipe/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid']},
  {type:'item',id:'steel_rod',name:'steel rod',mass_g:800,volume_ml:300,description:'A straight steel rod with dull ends, left among the lengths at a workshop bench.',art:'/art/items/steel_rod/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid']},
  {type:'item',id:'steel_wire',name:'steel wire',mass_g:200,volume_ml:180,description:'A tight coil of steel wire, still holding the curve it took on the shelf.',art:'/art/items/steel_wire/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','flexible']},
  {type:'item',id:'steel_chain',name:'steel chain',mass_g:1500,volume_ml:1000,description:'A length of steel chain, its links polished where they rubbed together.',art:'/art/items/steel_chain/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','flexible']},
  {type:'item',id:'wire_mesh',name:'wire mesh',mass_g:600,volume_ml:2000,description:'A cut panel of steel wire mesh. Someone stacked it flat rather than throw away the remainder.',art:'/art/items/wire_mesh/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','flexible']},
  {type:'item',id:'aluminum_sheet',name:'aluminum sheet',mass_g:600,volume_ml:1200,description:'A light aluminum panel with a cutting-sharp sheared edge, its face marked by the other sheets stored against it.',art:'/art/items/aluminum_sheet/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','opaque','rigid','sharp_edge']},
  {type:'item',id:'aluminum_tube',name:'aluminum tube',mass_g:300,volume_ml:800,description:'A short hollow aluminum tube, light enough to bring home for its metal.',art:'/art/items/aluminum_tube/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','opaque','rigid']},
  {type:'item',id:'copper_sheet',name:'copper sheet',mass_g:900,volume_ml:400,description:'A copper sheet offcut with a cutting-sharp sheared edge, tarnished where hands once lifted it from the rack.',art:'/art/items/copper_sheet/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','opaque','rigid','sharp_edge']},
  {type:'item',id:'plywood_panel',name:'plywood panel',mass_g:1800,volume_ml:3500,description:'A manageable plywood panel with the layers exposed along one edge. The wood is still worth saving.',art:'/art/items/plywood_panel/art.txt',flags:['salvage','combustible','water_absorbent','porous','electrically_insulating','opaque','rigid']},
  {type:'item',id:'wooden_dowel',name:'wooden dowel',mass_g:350,volume_ml:650,description:'A long wooden dowel, shaped straight from end to end and smooth from handling.',art:'/art/items/wooden_dowel/art.txt',flags:['salvage','combustible','water_absorbent','porous','electrically_insulating','opaque','rigid']},
  {type:'item',id:'rubber_sheet',name:'rubber sheet',mass_g:300,volume_ml:500,description:'A small sheet of rubber with the faint smell of the workshop where it was stored.',art:'/art/items/rubber_sheet/art.txt',flags:['salvage','combustible','electrically_insulating','opaque','flexible','elastic']},
  {type:'item',id:'foam_padding',name:'foam padding',mass_g:150,volume_ml:2000,description:'A pad of open-cell foam, soft and bulky in the hand. Its old cover is long gone.',art:'/art/items/foam_padding/art.txt',flags:['salvage','combustible','water_absorbent','porous','electrically_insulating','opaque','flexible','elastic']},
  {type:'item',id:'canvas_patch',name:'canvas patch',mass_g:150,volume_ml:500,description:'A heavy canvas patch, folded away by someone who expected their gear to last.',art:'/art/items/canvas_patch/art.txt',flags:['salvage','combustible','water_absorbent','porous','electrically_insulating','opaque','flexible']},
  {type:'item',id:'leather_patch',name:'leather patch',mass_g:120,volume_ml:250,description:'A supple leather offcut with an uneven edge and the dark marks of an old workbench.',art:'/art/items/leather_patch/art.txt',flags:['salvage','combustible','water_absorbent','porous','electrically_insulating','opaque','flexible']},
  {type:'item',id:'nylon_webbing',name:'nylon webbing',mass_g:100,volume_ml:200,description:'A length of woven nylon webbing, its cut ends carefully sealed before it was put away.',art:'/art/items/nylon_webbing/art.txt',flags:['salvage','combustible','porous','electrically_insulating','opaque','flexible']},
  {type:'item',id:'framing_nails',name:'framing nails',mass_g:100,volume_ml:80,description:'A packet of twenty framing nails. A builder counted these out for a job that never got finished.',art:'/art/items/framing_nails/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid','pointed']},
  {type:'item',id:'wood_screws',name:'wood screws',mass_g:100,volume_ml:80,description:'A packet of twenty wood screws. The label promises they will be easy to find when dropped.',art:'/art/items/wood_screws/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid','pointed']},
  {type:'item',id:'nuts_and_bolts',name:'nuts and bolts',mass_g:200,volume_ml:100,description:'Ten paired nuts and bolts in a little packet, kept together by a more organized hand.',art:'/art/items/nuts_and_bolts/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid']},
  {type:'item',id:'door_hinge',name:'door hinge',mass_g:150,volume_ml:70,description:'A single steel door hinge, with scuffed leaves and an intact pin. Paint caught around the screw holes remembers a room you will never see.',art:'/art/items/door_hinge/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid']},
  {type:'item',id:'coil_spring',name:'coil spring',mass_g:120,volume_ml:100,description:'A small steel coil spring from a box of replacement parts. An oily paper wrapper has kept the workshop damp off its turns.',art:'/art/items/coil_spring/art.txt',flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','elastic']},
]}
