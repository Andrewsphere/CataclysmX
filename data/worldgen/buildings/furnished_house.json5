{format_version:1, definitions:[{
  type:'building_pattern', id:'furnished_house', weight:1000, use:'residential',
  // Curated footprint: kitchen/dining west, sitting/sleeping east, enclosed WC
  // in the northeast corner. Keep the central divider and review probes stable.
  rows:[
    '###w####u###',
    '#.....#.#.t#',
    '#.....#.#..#',
    '#s....+.#+##',
    '#.....#....#',
    '#.....#a...#',
    '#..>..#....#',
    '###+########',
  ],
  palette:{'#':'wall', '.':'floor', '+':'closed_door', '>':'stairs',
    w:'window',u:'window_curtained',
    s:{terrain:'floor',object:'kitchen_stove',facing:'east'},
    t:{terrain:'floor',object:'house_toilet',facing:'west'},
    a:{terrain:'floor',object:'house_sofa',facing:'east'}},
  entrance:{x:3,z:7},
  furniture:[
    {x:1,z:1,y:0,object:'kitchen_cabinet',facing:'south'},
    {x:2,z:1,y:0,object:'kitchen_cabinet',facing:'south'},
    {x:4,z:2,y:0,object:'house_table',facing:'north'},
    {x:3,z:2,y:0,object:'house_chair',facing:'east'},
    {x:3,z:1,y:0,object:'kitchen_sink',facing:'south'},
    {x:1,z:5,y:0,object:'kitchen_cabinet',facing:'east'},
    {x:9,z:1,y:0,object:'bathroom_cabinet',facing:'south'},
    {x:10,z:5,y:0,object:'house_bed',facing:'west'},
    {x:10,z:6,y:0,object:'bedroom_cabinet',facing:'west'},
    {x:3,z:4,y:0,object:'cellar_lamp',facing:'north'},
    {x:9,z:4,y:0,object:'cellar_lamp',facing:'north'},
  ],
  loot:[
    {x:1,z:1,y:0,pool:'house_kitchen',chance:10000,rolls:1,destination:'furniture'},
    {x:2,z:1,y:0,pool:'house_pantry',chance:10000,rolls:1,destination:'furniture'},
    {x:2,z:1,y:0,pool:'house_household_supplies',chance:10000,rolls:2,destination:'furniture'},
    {x:9,z:1,y:0,pool:'house_bathroom',chance:10000,rolls:1,destination:'furniture'},
    {x:10,z:6,y:0,pool:'house_linen',chance:10000,rolls:1,destination:'furniture'},
  ],
  monsters:[],
  basements:[
    // Rear pantry/storage room; household cupboards beside the stair landing.
    {id:'storage_cellar',weight:1,rows:[
      '############','#..........#','#..........#','#..........#',
      '####+#######','#..........#','#..>.......#','############',
    ], furniture:[{x:1,z:1,y:-1,object:'cellar_chest',facing:'south'},
      {x:10,z:1,y:-1,object:'kitchen_cabinet',facing:'west'},
      {x:1,z:5,y:-1,object:'bedroom_cabinet',facing:'east'},
      {x:10,z:6,y:-1,object:'bathroom_cabinet',facing:'north'},
      {x:4,z:5,y:-1,object:'cellar_lamp',facing:'north'}],
    loot:[{x:1,z:1,y:-1,pool:'house_storage',chance:10000,rolls:2,destination:'furniture'},
      {x:10,z:1,y:-1,pool:'house_pantry',rolls:2,destination:'furniture'},
      {x:10,z:6,y:-1,pool:'house_household_supplies',rolls:2,destination:'furniture'}], monsters:[]},
    // Separate bench/tool room and lower household/bulk-storage landing.
    {id:'workshop_cellar',weight:1,rows:[
      '############','#..........#','#..........#','#..........#',
      '####+#######','#..........#','#..>.......#','############',
    ], furniture:[{x:1,z:1,y:-1,object:'workshop_bench',facing:'south'},
      {x:7,z:1,y:-1,object:'cellar_chest',facing:'south'},
      {x:1,z:5,y:-1,object:'cellar_chest',facing:'east'},
      {x:10,z:6,y:-1,object:'bedroom_cabinet',facing:'north'},
      {x:4,z:5,y:-1,object:'cellar_lamp',facing:'north'}],
    loot:[{x:1,z:1,y:-1,pool:'house_hammer',chance:10000,rolls:1,destination:'furniture'},
      {x:1,z:1,y:-1,pool:'house_workshop',chance:10000,rolls:3,destination:'furniture'},
      {x:7,z:1,y:-1,pool:'house_storage',rolls:2,destination:'furniture'},
      {x:1,z:5,y:-1,pool:'house_household_supplies',destination:'furniture'}],
    monsters:[{x:10,z:1,y:-1,group:'cellar_zombies',chance:3000}]},
  ],
}]}
