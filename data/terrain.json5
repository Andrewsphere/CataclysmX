// Stable content names; numeric runtime IDs are assigned after sorting each type.
{
  format_version: 1,
  ai_profiles: [{id: 'sighted_zombie'}],
  objects: [
    {
      id: 'scrap_press', name: 'scrap press', behavior: 'crafting_machine',
      machine: {
        input: 'scrap', input_count: 3,
        output: 'metal_pipe', output_count: 1,
        duration_ticks: 300, energy_capacity: 3000, energy_per_tick: 2,
      },
    },
  ],
  definitions: [
    {type: 'item', id: 'rock', name: 'rock', mass_g: 500, volume_ml: 250},
    {
      type: 'item', id: 'backpack', name: 'backpack', mass_g: 1000, volume_ml: 2000,
      capabilities: [{type: 'container', id: 'storage', capacity_volume_ml: 20000}],
    },
    {type: 'item', id: 'bandage', name: 'bandage', mass_g: 20, volume_ml: 50},
    {type: 'item', id: 'scrap', name: 'scrap', mass_g: 100, volume_ml: 100},
    {type: 'item', id: 'metal_pipe', name: 'metal pipe', mass_g: 1500, volume_ml: 1000},
    {type: 'item', id: 'wood_plank', name: 'wood plank', mass_g: 2000, volume_ml: 3000},
    {type: 'item', id: 'blinking_lightbulb', name: 'blinking lightbulb', mass_g: 50, volume_ml: 100},
    {type: 'item', id: 'toggle_lightbulb', name: 'toggle lightbulb', mass_g: 50, volume_ml: 100},
    {type: 'item', id: 'single_blink_lightbulb', name: 'single-blink lightbulb', mass_g: 50, volume_ml: 100},
    {
      type: 'item', id: 'disposable_battery', name: 'disposable battery', mass_g: 25, volume_ml: 10,
      capabilities: [{type: 'energy_store', id: 'power', capacity_energy: 1000,
        initial_energy: 1000, rechargeable: false, battery_class: 'aa'}],
    },
    {
      type: 'item', id: 'rechargeable_battery', name: 'rechargeable battery', mass_g: 30, volume_ml: 10,
      capabilities: [{type: 'energy_store', id: 'power', capacity_energy: 1000,
        initial_energy: 0, rechargeable: true, battery_class: 'aa'}],
    },
    {
      type: 'item', id: 'field_charger', name: 'field charger', mass_g: 500, volume_ml: 500,
      capabilities: [
        {type: 'energy_store', id: 'power', capacity_energy: 2000, initial_energy: 2000, rechargeable: false},
        {type: 'charger', id: 'charger', power_source: 'power', battery_class: 'aa', energy_per_turn: 3},
      ],
    },
    {
      type: 'item', id: 'door_controller', name: 'door controller', mass_g: 200, volume_ml: 200,
      capabilities: [{type: 'door_controller', id: 'timer', delay_ticks: 300}],
    },
    {
      type: 'item', id: 'utility_controller', name: 'utility controller', mass_g: 700, volume_ml: 700,
      capabilities: [
        {type: 'door_controller', id: 'timer', delay_ticks: 300},
        {type: 'energy_store', id: 'power', capacity_energy: 2000, initial_energy: 2000, rechargeable: false},
        {type: 'charger', id: 'charger', power_source: 'power', battery_class: 'aa', energy_per_turn: 3},
      ],
    },
    {
      type: 'terrain', id: 'air', name: 'open air',
      movement: {passable: true}, blocks_sight: false, open_space: true,
      appearance: {symbol: ' ', foreground: 'light_cyan', background: 'black'},
    },
    {
      type: 'terrain', id: 'stairs', name: 'stairs',
      movement: {passable: true}, blocks_sight: false, stairs: true,
      appearance: {symbol: '>', foreground: 'white', background: 'black'},
    },
    {
      type: 'terrain', id: 'floor', name: 'floor',
      movement: {passable: true}, blocks_sight: false,
      appearance: {symbol: '.', foreground: 'light_gray', background: 'black'},
    },
    {
      type: 'terrain', id: 'wall', name: 'wall',
      movement: {passable: false}, blocks_sight: true,
      appearance: {symbol: '#', foreground: 'light_gray', background: 'black'},
    },
    {
      type: 'terrain', id: 'closed_door', name: 'closed door',
      movement: {passable: false}, blocks_sight: true,
      appearance: {symbol: '+', foreground: 'light_gray', background: 'black'},
      opens_to: 'open_door',
    },
    {
      type: 'terrain', id: 'open_door', name: 'open door',
      movement: {passable: true}, blocks_sight: false,
      appearance: {symbol: '/', foreground: 'light_gray', background: 'black'},
      closes_to: 'closed_door',
    },
    {
      type: 'terrain', id: 'lockable_closed_door', name: 'closed unlocked door',
      movement: {passable: false}, blocks_sight: true, looks_like: 'closed_door',
      opens_to: 'lockable_open_door', locks_to: 'locked_door',
    },
    {
      type: 'terrain', id: 'lockable_open_door', name: 'open unlocked door',
      movement: {passable: true}, blocks_sight: false, looks_like: 'open_door',
      closes_to: 'lockable_closed_door', locks_to: 'locked_door',
    },
    {
      type: 'terrain', id: 'locked_door', name: 'locked door',
      movement: {passable: false}, blocks_sight: true, looks_like: 'closed_door',
      unlocks_to: 'lockable_closed_door',
    },
    {
      type: 'terrain', id: 'grass', name: 'grass',
      movement: {passable: true}, blocks_sight: false,
      appearance: {symbol: '.', foreground: 'green'},
    },
    {
      type: 'terrain', id: 'tree', name: 'tree',
      movement: {passable: false}, blocks_sight: true,
      appearance: {symbol: 'T', foreground: 'green'},
    },
    {
      type: 'terrain', id: 'road', name: 'road',
      movement: {passable: true}, blocks_sight: false,
      appearance: {symbol: '.', foreground: 'dark_gray'},
    },
    {
      type: 'terrain', id: 'rubble', name: 'rubble',
      movement: {passable: true}, blocks_sight: false,
      appearance: {symbol: ':', foreground: 'light_gray'},
    },
    {
      type: 'building_pattern', id: 'compact_house', weight: 4,
      rows: [
        '########',
        '#......#',
        '#......#',
        '#......#',
        '#......#',
        '###+####',
      ],
      palette: {'#': 'wall', '.': 'floor', '+': 'closed_door'},
      entrance: {x: 3, z: 5},
    },
    {
      type: 'building_pattern', id: 'divided_house', weight: 2,
      rows: [
        '############',
        '#.....#....#',
        '#.....#....#',
        '#.....+....#',
        '#.....#....#',
        '#.....#....#',
        '#.....#....#',
        '###+########',
      ],
      palette: {'#': 'wall', '.': 'floor', '+': 'closed_door'},
      entrance: {x: 3, z: 7},
    },
    {
      // This footprint crosses a 16-tile chunk boundary even without rotation.
      type: 'building_pattern', id: 'long_house', weight: 1,
      rows: [
        '########################',
        '#..........#...........#',
        '#..........#...........#',
        '#..........#...........#',
        '#..........#...........#',
        '#..........+...........#',
        '#..........#...........#',
        '#..........#...........#',
        '#..........#...........#',
        '#..........#...........#',
        '#..........#...........#',
        '#####+##################',
      ],
      palette: {'#': 'wall', '.': 'floor', '+': 'closed_door'},
      entrance: {x: 5, z: 11},
    },
  ],
}
