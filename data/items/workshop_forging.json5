{format_version:1, definitions:[
  {type:'tool_trait',id:'anvil',name:'Anvil'},
  {type:'tool_trait',id:'forge_heat',name:'Forge heat'},
  {type:'tool_trait',id:'metal_holding',name:'Metal holding'},
  {type:'tool_trait',id:'metal_saw',name:'Metal sawing'},
  {type:'tool_trait',id:'metal_drilling',name:'Metal drilling'},
  {type:'tool_trait',id:'wrenching',name:'Wrenching'},
  {type:'tool_trait',id:'screwdriving',name:'Screwdriving'},

  {type:'item',id:'solid_steel_block',name:'solid steel block',mass_g:20000,volume_ml:3000,
   description:'Chalk numbers cling to one square end of this recovered block. Most scavengers left it where it lay; someone with a stand to build might see the beginning of a workshop.',
   flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid'],
   art:'/art/items/solid_steel_block/art.txt'},
  {type:'item',id:'refractory_brick',name:'refractory brick',mass_g:2500,volume_ml:1400,
   description:'A pale firebrick with soot tucked into its maker stamp. The kiln it belonged to is silent, but its place beside a new hearth is easy to imagine.',
   flags:['salvage','brittle','porous','opaque','rigid','electrically_insulating'],
   art:'/art/items/refractory_brick/art.txt'},
  {type:'item',id:'charcoal_charge',name:'bag of forge charcoal',mass_g:1000,volume_ml:4000,
   description:'Black dust has worked into every fold of the paper sack. Keeping this charcoal dry feels like setting aside a little of tomorrow.',
   flags:['salvage','combustible','porous','opaque'],
   art:'/art/items/charcoal_charge/art.txt',recovery_allowed:false},
  {type:'item',id:'crude_anvil_kit',name:'crude anvil and stand',mass_g:24000,volume_ml:28000,
   description:'A recovered steel block sits strapped to a low timber stand. The first blows will leave their marks beside the old handling scars.',
   flags:['tool','combustible','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid','collapsible'],
   art:'/art/items/crude_anvil_kit/art.txt',placed_object:'crude_anvil'},
  {type:'item',id:'charcoal_forge_kit',name:'charcoal forge and bellows',mass_g:27000,volume_ml:45000,
   description:'The little brick hearth and leather bellows have the patient look of equipment made to be used for years. Packed cold, they wait for a place out of the wind.',
   flags:['tool','combustible','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid','collapsible'],
   art:'/art/items/charcoal_forge_kit/art.txt',placed_object:'charcoal_forge'},
  {type:'item',id:'forging_tongs',name:'forging tongs',mass_g:1500,volume_ml:1200,
   description:'The long reins have darkened where a smith held them, well away from the jaws. Bringing hot work under control begins with this unremarkable pair of hands.',
   flags:['tool','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid'],
   art:'/art/items/forging_tongs/art.txt',tool_traits:[{id:'metal_holding',tier:2}]},
  {type:'item',id:'smithing_hammer',name:'smithing hammer',mass_g:1300,volume_ml:850,
   description:'A broad face and a narrow peen bear the satin wear of repeated blows. The wooden grip settles into the palm with none of the noise it is about to make.',
   flags:['tool','combustible','water_absorbent','porous','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid'],
   art:'/art/items/smithing_hammer/art.txt',tool_traits:[{id:'hammering',tier:2}],
   melee:{damage:[{type:'blunt',amount:1400}],attack_cost:130,handling_skill:'clubs_hammers',
          grips:[{kind:'one_handed'}],block_capacity:250,allowed_responses:['parry','block']}},
  {type:'item',id:'fabricated_anvil_kit',name:'fabricated anvil and stand',mass_g:25000,volume_ml:30000,
   description:'A fitted steel face and forming shoulder give the recovered block a new purpose. Careful joints in the stand suggest someone finally had the tools to do the job properly.',
   flags:['tool','combustible','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid','collapsible'],
   art:'/art/items/fabricated_anvil_kit/art.txt',placed_object:'fabricated_anvil'},
  {type:'item',id:'spring_steel_bar',name:'spring-steel bar',mass_g:1800,volume_ml:400,
   description:'A continuous length of selected spring steel, straightened and set apart from the miscellaneous offcuts. Someone saved this one for work that could not afford a hidden weakness.',
   flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid'],
   art:'/art/items/spring_steel_bar/art.txt'},
  {type:'item',id:'tool_steel_blank',name:'tool-steel blank',mass_g:300,volume_ml:80,
   description:'A short billet cut from suitable carbon-steel stock. Its fresh ends catch the light differently from the dark skin left by the forge.',
   flags:['salvage','electrically_conductive','thermally_conductive','ferromagnetic','opaque','rigid'],
   art:'/art/items/tool_steel_blank/art.txt'},
  // Rigid 32 L envelope includes walls and void: unlike a folded bag it stays bulky.
  {type:'item',id:'wooden_workshop_crate',name:'wooden workshop crate',mass_g:6000,volume_ml:32000,
   description:'The hand-cut joints are a little uneven, but the bottom sits square. Small supplies no longer have to disappear into the dust under the bench.',
   flags:['container','combustible','water_absorbent','porous','electrically_insulating','opaque','rigid'],
   art:'/art/items/wooden_workshop_crate/art.txt',
   capabilities:[{type:'container',id:'storage',capacity_volume_ml:24000}]},
]}
