if(NOT DEFINED RUN_DIR OR NOT DEFINED STATUS)
    message(FATAL_ERROR "RUN_DIR and STATUS are required")
endif()

# Read only bounded portions, even when CTest or the tests produce enormous logs.
function(read_tail path limit output)
    if(EXISTS "${path}")
        file(SIZE "${path}" size)
        math(EXPR offset "${size} - ${limit}")
        if(offset LESS 0)
            set(offset 0)
        endif()
        file(READ "${path}" text OFFSET ${offset} LIMIT ${limit})
        set(${output} "${text}" PARENT_SCOPE)
    else()
        set(${output} "" PARENT_SCOPE)
    endif()
endfunction()

if(EXISTS "${RUN_DIR}/ctest.log")
    file(READ "${RUN_DIR}/ctest.log" beginning LIMIT 3000)
endif()
read_tail("${RUN_DIR}/ctest.log" 5500 output)
read_tail("${RUN_DIR}/ctest.err" 2000 errors)
if(STATUS EQUAL 0)
    if(output MATCHES "100% tests passed, [^\n]*")
        set(summary "${CMAKE_MATCH_0}")
        if(output MATCHES "Total Test time \\(real\\) = *([^\r\n]*)")
            string(APPEND summary " (${CMAKE_MATCH_1})")
        endif()
        message("CTest: ${summary}")
    elseif(output MATCHES "No tests were found" OR errors MATCHES "No tests were found")
        message("CTest: no tests found (exit 0).")
    else()
        message("CTest: completed with exit 0; no test-run summary was produced. Log: ${RUN_DIR}/ctest.log")
    endif()
else()
    message("CTest failed (exit ${STATUS}). Output excerpts follow; they may be truncated.")
    if(NOT beginning STREQUAL "")
        message("Start of CTest output:\n${beginning}")
    endif()
    if(NOT output STREQUAL "")
        message("End of CTest output:\n${output}")
    endif()
    if(NOT errors STREQUAL "")
        message("CTest stderr:\n${errors}")
    endif()
    message("Full stdout: ${RUN_DIR}/ctest.log\nFull stderr: ${RUN_DIR}/ctest.err\nJUnit report (if produced): ${RUN_DIR}/results.xml")
endif()
